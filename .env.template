# VigilNet WhatsApp Configuration
# 
# IMPORTANT: This file contains sensitive credentials
# NEVER commit this file to Git - it's already in .gitignore
# KEEP THIS FILE PRIVATE AND SECURE
#
# How to get these values:
# 1. Sign up at https://www.twilio.com/try-twilio (free account)
# 2. Go to Twilio Console → Account Info
# 3. Copy Account SID and Auth Token
# 4. Go to Messaging → WhatsApp → Sandbox Settings
# 5. Copy the Sandbox Phone Number
# 6. Add your personal number to sandbox (send "join [code]" message)
# 7. Fill in the values below

# Your Twilio Account SID (from console.twilio.com)
# Looks like: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=

# Your Twilio Auth Token (from console.twilio.com)
# Keep this SECRET!
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp Sandbox Number (from Messaging → WhatsApp → Sandbox)
# Looks like: +1234567890
TWILIO_WHATSAPP_FROM=

# Your WhatsApp number where you want to receive alerts
# Format: +[country_code][number]
# Example: +919876543210 (for India)
# Example: +441234567890 (for UK)
WHATSAPP_RECIPIENT=
