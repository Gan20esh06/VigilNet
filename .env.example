# Twilio Credentials (from twilio.com console)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp Phone Numbers
# Format: +[country_code][phone_number] (e.g., +919876543210)
TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_sandbox_number
WHATSAPP_RECIPIENT=your_recipient_whatsapp_number
